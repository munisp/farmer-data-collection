# Enterprise Infrastructure Environment Variables
# Copy this file to .env.enterprise and update with your values

# ==================== Database Configuration ====================
DATABASE_URL=postgresql://farmer_user:farmer_pass_2024@localhost:5432/farmer_db
POSTGRES_USER=farmer_user
POSTGRES_PASSWORD=farmer_pass_2024
POSTGRES_DB=farmer_db

# ==================== Redis Configuration ====================
REDIS_URL=redis://:redis_pass_2024@localhost:6379
REDIS_PASSWORD=redis_pass_2024

# ==================== Kafka Configuration ====================
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=farmer-app
KAFKA_GROUP_ID=farmer-consumer-group

# Kafka Topics
KAFKA_TOPIC_FARMER_EVENTS=farmer-events
KAFKA_TOPIC_FARM_EVENTS=farm-events
KAFKA_TOPIC_CROP_EVENTS=crop-events
KAFKA_TOPIC_LIVESTOCK_EVENTS=livestock-events
KAFKA_TOPIC_HARVEST_EVENTS=harvest-events
KAFKA_TOPIC_EXPENSE_EVENTS=expense-events
KAFKA_TOPIC_CACHE_INVALIDATION=cache-invalidation
KAFKA_TOPIC_AUDIT_TRAIL=audit-trail
KAFKA_TOPIC_ANALYTICS=analytics
KAFKA_TOPIC_AUTH_EVENTS=auth-events

# ==================== Permify Configuration ====================
PERMIFY_URL=http://localhost:3476
PERMIFY_GRPC_URL=localhost:3478
PERMIFY_TENANT_ID=t1

# ==================== TigerBeetle Configuration ====================
TIGERBEETLE_URL=localhost:3001
TIGERBEETLE_CLUSTER_ID=0

# ==================== Dapr Configuration ====================
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
DAPR_APP_ID=farmer-app
DAPR_APP_PORT=3000

# ==================== Security Services ====================

# Wazuh (SIEM)
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword

# OpenCTI (Threat Intelligence)
OPENCTI_URL=http://localhost:8081
OPENCTI_TOKEN=ChangeMe
OPENCTI_ADMIN_EMAIL=admin@opencti.io
OPENCTI_ADMIN_PASSWORD=ChangeMePlease

# OpenAppSec (WAF)
OPENAPPSEC_MODE=prevent
OPENAPPSEC_LOG_LEVEL=info

# ==================== Monitoring & Observability ====================

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jaeger (Distributed Tracing)
JAEGER_URL=http://localhost:16686
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# ==================== Application Configuration ====================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_EXPIRY=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== Feature Flags ====================
ENABLE_KAFKA_EVENTS=true
ENABLE_PERMIFY_AUTH=true
ENABLE_DAPR_MESH=true
ENABLE_TIGERBEETLE_LEDGER=true
ENABLE_REDIS_CACHE=true
ENABLE_SECURITY_MONITORING=true

# ==================== Logging Configuration ====================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# ==================== External Services ====================

# Email Service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourapp.com

# SMS Service (optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Cloud Storage (optional)
S3_BUCKET=farmer-data-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# ==================== Backup Configuration ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=farmer-backups

# ==================== Performance Tuning ====================
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT=30000
REDIS_MAX_CONNECTIONS=50
KAFKA_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_REQUEST_TIMEOUT_MS=30000

# ==================== Development/Testing ====================
# Only use in development!
ENABLE_DEBUG_LOGGING=false
DISABLE_AUTH=false
MOCK_EXTERNAL_SERVICES=false
