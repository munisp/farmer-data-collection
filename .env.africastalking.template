# ============================================================================
# Africa's Talking Configuration Template
# ============================================================================
# 
# Instructions:
# 1. Copy this file to .env (or add these variables to your existing .env)
# 2. Replace all placeholder values with your actual Africa's Talking credentials
# 3. Never commit .env file to version control
# 4. Keep API keys secure and rotate regularly
#
# Get your credentials from: https://account.africastalking.com/
# Navigate to: Apps → [Your App] → Settings → API Key
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Africa's Talking Core Credentials
# ----------------------------------------------------------------------------

# Your Africa's Talking username (usually your phone number or email)
# Example: +254712345678 or myapp@example.com
AFRICASTALKING_USERNAME=

# Your Africa's Talking API Key (starts with "atsk_")
# IMPORTANT: This is shown only once when generated. Save it securely!
# Example: atsk_1234567890abcdef1234567890abcdef
AFRICASTALKING_API_KEY=

# Environment: "sandbox" for testing, "production" for live deployment
# Start with "sandbox" to test without costs, then switch to "production"
AFRICASTALKING_ENV=sandbox

# ----------------------------------------------------------------------------
# OPTIONAL: SMS Configuration
# ----------------------------------------------------------------------------

# Custom SMS Sender ID (requires approval from Africa's Talking)
# Max 11 alphanumeric characters, no spaces
# Example: FARMDATA, AGRIAPP, FARMCOLL
# Leave empty to use default sender ID
AFRICASTALKING_SENDER_ID=

# ----------------------------------------------------------------------------
# OPTIONAL: Application Configuration
# ----------------------------------------------------------------------------

# Your application's public URL (for webhooks)
# Must be HTTPS with valid SSL certificate
# Example: https://farmdata.com or https://farmdata.manus.space
APP_URL=

# Webhook endpoints (auto-generated from APP_URL)
# These are set automatically in the code, but you can override if needed
# USSD_WEBHOOK_URL=${APP_URL}/api/trpc/messaging.ussdCallback
# SMS_WEBHOOK_URL=${APP_URL}/api/trpc/messaging.smsCallback
# WHATSAPP_WEBHOOK_URL=${APP_URL}/api/trpc/messaging.whatsappCallback

# ----------------------------------------------------------------------------
# EXISTING: Database Configuration (Already Configured)
# ----------------------------------------------------------------------------

# These should already be set in your .env file
# DATABASE_URL=postgresql://user:password@host:5432/database
# JWT_SECRET=your_jwt_secret
# ... (other existing variables)

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
#
# Before deploying to production:
# 
# [ ] Created Africa's Talking account
# [ ] Completed KYC verification
# [ ] Funded account ($50+ recommended)
# [ ] Created application in dashboard
# [ ] Generated API key and saved securely
# [ ] Configured SMS callback URL in dashboard
# [ ] Applied for USSD short code (if using USSD)
# [ ] Applied for WhatsApp Business API (if using WhatsApp)
# [ ] Set AFRICASTALKING_USERNAME above
# [ ] Set AFRICASTALKING_API_KEY above
# [ ] Set APP_URL above
# [ ] Changed AFRICASTALKING_ENV to "production"
# [ ] Tested all webhooks in sandbox
# [ ] Verified database writes are working
# [ ] Set up monitoring and alerts
# [ ] Reviewed cost estimates
#
# ============================================================================
# COST REFERENCE (as of Nov 2025)
# ============================================================================
#
# Per-Message Costs:
# - USSD: ~$0.01 per session
# - SMS: ~$0.05 per message
# - WhatsApp: ~$0.005 per message
#
# Monthly Fixed Costs:
# - USSD Short Code: $200-500/month
# - SMS Dedicated Number: $10-20/month (optional)
# - WhatsApp Business API: $0 (pay per message)
#
# For 1,000 users with 10 interactions/month:
# - USSD: $50/month (5,000 sessions)
# - SMS: $150/month (3,000 messages)
# - WhatsApp: $10/month (2,000 messages)
# - Total: $420-730/month (including fixed costs)
