{
  "name": "farmer-data-collection",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_data tsx watch server/index.ts\"",
    "dev:client": "vite --host",
    "dev:server": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_data tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_data vitest run",
    "test:watch": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_data vitest",
    "audit:production-readiness": "python3.11 scripts/production_readiness_audit.py --root . --config scripts/production_readiness_config.json --output-dir reports/production-readiness --print-summary",
    "audit:production-readiness:ci": "python3.11 scripts/production_readiness_audit.py --root . --config scripts/production_readiness_config.json --output-dir reports/production-readiness --min-score 75 --strict --print-summary"
  },
