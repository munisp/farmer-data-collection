# Staging Environment Configuration
# Copy this file to .env.local on staging server

# Environment
NODE_ENV=staging

# Database (Replace with staging database URL)
DATABASE_URL=postgresql://farmer_user:farmer_pass@staging-db.example.com:5432/farmer_data_staging

# Redis (Replace with staging Redis URL)
REDIS_URL=redis://staging-redis.example.com:6379

# Kafka (Replace with staging Kafka brokers)
KAFKA_BROKERS=staging-kafka1.example.com:9093,staging-kafka2.example.com:9093

# JWT Secret (Generate new secret for staging)
JWT_SECRET=staging-jwt-secret-change-this-in-production

# OAuth (Use staging OAuth server)
OAUTH_SERVER_URL=https://staging-oauth.example.com
VITE_OAUTH_PORTAL_URL=https://staging-oauth.example.com/portal

# SMS Configuration (Use test credentials in staging)
TWILIO_ACCOUNT_SID=your-staging-twilio-account-sid
TWILIO_AUTH_TOKEN=your-staging-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (Use test keys in staging)
STRIPE_SECRET_KEY=sk_test_staging_key
STRIPE_WEBHOOK_SECRET=whsec_staging_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_staging_key

# ERPNext Integration (Use staging ERPNext instance)
ERPNEXT_URL=https://staging-erp.example.com
ERPNEXT_API_KEY=staging-api-key
ERPNEXT_API_SECRET=staging-api-secret

# CORS Configuration
ALLOWED_ORIGINS=https://staging.farmer-app.com,https://staging-admin.farmer-app.com

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Logging
LOG_LEVEL=debug

# Rate Limiting (More lenient in staging)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Session Configuration
SESSION_SECRET=staging-session-secret-change-this
SESSION_MAX_AGE=86400000

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/var/uploads/staging

# Email Configuration (Use test email in staging)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging-smtp-user
SMTP_PASS=staging-smtp-pass
SMTP_FROM=noreply@staging.farmer-app.com

# Analytics
VITE_ANALYTICS_WEBSITE_ID=staging-website-id
VITE_ANALYTICS_ENDPOINT=https://analytics.example.com

# Feature Flags
ENABLE_MARKETPLACE=true
ENABLE_MICROFINANCE=true
ENABLE_ERPNEXT_SYNC=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_WEATHER_ALERTS=true

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Security
HELMET_CSP_ENABLED=true
CORS_ENABLED=true
RATE_LIMITING_ENABLED=true

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_ITEMS=1000
