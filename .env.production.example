# Production Environment Configuration
# Copy this file to .env.production and fill in the values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/farmer_data_collection
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
OAUTH_SERVER_URL=https://oauth.yourdomain.com
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=Admin Name

# ============================================
# S3 STORAGE
# ============================================
S3_BUCKET=farmer-data-collection-prod
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_ENDPOINT=  # Optional: for MinIO or custom S3-compatible storage
CDN_URL=https://cdn.yourdomain.com  # Optional: CloudFront or CDN URL

# ============================================
# EMAIL SERVICE
# ============================================
EMAIL_PROVIDER=sendgrid  # or 'smtp'
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Farmer Data Collection

# SendGrid (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=your-sendgrid-api-key

# SMTP (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password-or-app-password

# ============================================
# STRIPE PAYMENT
# ============================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3000
VITE_APP_URL=https://app.yourdomain.com
VITE_APP_TITLE=Farmer Data Collection
VITE_APP_LOGO=/logo.svg
VITE_APP_ID=farmer-data-collection-prod

# ============================================
# MICROSERVICES
# ============================================
PYTHON_ML_SERVICE_URL=http://localhost:3000
GO_WEBSOCKET_SERVICE_URL=http://localhost:8081
GO_IMAGE_SERVICE_URL=http://localhost:8080

# ============================================
# ANALYTICS
# ============================================
VITE_ANALYTICS_ENDPOINT=https://analytics.yourdomain.com
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# ============================================
# FORGE API (Built-in)
# ============================================
BUILT_IN_FORGE_API_KEY=your-forge-api-key
BUILT_IN_FORGE_API_URL=https://forge.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im

# ============================================
# OAUTH PORTAL
# ============================================
VITE_OAUTH_PORTAL_URL=https://oauth.yourdomain.com

# ============================================
# SECURITY
# ============================================
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # max requests per window
SESSION_TIMEOUT_MINUTES=60

# ============================================
# MONITORING & LOGGING
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info  # debug, info, warn, error
ENABLE_REQUEST_LOGGING=true

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_2FA=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true
