[
  {
    "id": "FC-001",
    "phase": 1,
    "pattern": "(?i)(union.*select|select.*from|insert.*into|delete.*from|drop.*table|create.*table|alter.*table)",
    "targets": ["ARGS", "BODY", "HEADERS"],
    "severity": "CRITICAL",
    "action": "block",
    "description": "SQL Injection prevention"
  },
  {
    "id": "FC-002",
    "phase": 1,
    "pattern": "(?i)(<script|javascript:|vbscript:|onload=|onerror=|onclick=|onmouseover=|eval\\(|expression\\()",
    "targets": ["ARGS", "BODY"],
    "severity": "HIGH",
    "action": "block",
    "description": "XSS prevention"
  },
  {
    "id": "FC-003",
    "phase": 1,
    "pattern": "(?i)(\\.\\.[\\/\\\\]|\\.\\.%2[fF]|%2e%2e[\\/\\\\])",
    "targets": ["URI", "ARGS"],
    "severity": "HIGH",
    "action": "block",
    "description": "Path traversal prevention"
  },
  {
    "id": "FC-004",
    "phase": 1,
    "pattern": "(?i)(\\$\\{|\\$\\(|`.*`|\\|\\||&&|;.*\\b(cat|ls|pwd|whoami|id|uname|wget|curl|bash|sh|python|perl|ruby)\\b)",
    "targets": ["ARGS", "BODY"],
    "severity": "CRITICAL",
    "action": "block",
    "description": "Command injection prevention"
  },
  {
    "id": "FC-005",
    "phase": 2,
    "pattern": "(?i)(xxe|<!entity|<!doctype.*system|<!doctype.*public)",
    "targets": ["BODY"],
    "severity": "HIGH",
    "action": "block",
    "description": "XXE injection prevention"
  },
  {
    "id": "FC-006",
    "phase": 1,
    "pattern": "(?i)(bot|crawler|spider|scraper|masscan|nmap|nikto|sqlmap|havij|acunetix|nessus|openvas)",
    "targets": ["HEADERS:User-Agent"],
    "severity": "MEDIUM",
    "action": "block",
    "description": "Malicious scanner/bot blocking"
  },
  {
    "id": "FC-007",
    "phase": 1,
    "pattern": "(?i)(Bearer\\s+[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+)",
    "targets": ["ARGS", "BODY"],
    "severity": "HIGH",
    "action": "block",
    "description": "JWT token in query params/body (must be in Authorization header)"
  },
  {
    "id": "FC-008",
    "phase": 2,
    "pattern": "(?i)(password|passwd|secret|api_key|apikey|access_token|refresh_token|private_key)",
    "targets": ["RESPONSE_BODY"],
    "severity": "HIGH",
    "action": "log",
    "description": "Sensitive data in response detection"
  },
  {
    "id": "FC-009",
    "phase": 1,
    "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
    "targets": ["HEADERS:Host"],
    "severity": "MEDIUM",
    "action": "block",
    "description": "Block direct IP access (require hostname)"
  },
  {
    "id": "FC-010",
    "phase": 1,
    "pattern": "(?i)(\\bexec\\b|\\bsystem\\b|\\bpassthru\\b|\\bshell_exec\\b|\\bpopen\\b|\\bproc_open\\b)",
    "targets": ["ARGS", "BODY"],
    "severity": "CRITICAL",
    "action": "block",
    "description": "PHP/server-side code injection prevention"
  }
]
