{
  "admin": {
    "listen": "0.0.0.0:2019",
    "enforce_origin": false,
    "origins": ["localhost:2019", "caddy:2019"]
  },
  "logging": {
    "logs": {
      "default": {
        "writer": {
          "output": "stdout"
        },
        "encoder": {
          "format": "json"
        },
        "level": "INFO",
        "include": ["caddy.access.*"]
      }
    }
  },
  "apps": {
    "http": {
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "srv0": {
          "listen": [":443"],
          "protocols": ["h1", "h2", "h3"],
          "routes": [
            {
              "match": [{"host": ["farmconnect.africa", "www.farmconnect.africa"]}],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "set": {
                      "Strict-Transport-Security": ["max-age=63072000; includeSubDomains; preload"],
                      "X-Frame-Options": ["SAMEORIGIN"],
                      "X-Content-Type-Options": ["nosniff"],
                      "X-XSS-Protection": ["1; mode=block"]
                    },
                    "delete": ["Server", "X-Powered-By"]
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{"dial": "app:3000"}],
                  "headers": {
                    "request": {
                      "set": {
                        "X-Real-IP": ["{http.request.remote.host}"],
                        "X-Forwarded-Proto": ["{http.request.scheme}"],
                        "X-Request-ID": ["{http.request.uuid}"]
                      }
                    }
                  }
                }
              ]
            },
            {
              "match": [{"host": ["api.farmconnect.africa"]}],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{"dial": "openappsec-waf:80"}],
                  "headers": {
                    "request": {
                      "set": {
                        "X-Real-IP": ["{http.request.remote.host}"],
                        "X-Forwarded-Proto": ["{http.request.scheme}"],
                        "X-Forwarded-Host": ["{http.request.host}"],
                        "X-Request-ID": ["{http.request.uuid}"]
                      }
                    }
                  },
                  "health_checks": {
                    "active": {
                      "uri": "/health",
                      "interval": "10s",
                      "timeout": "5s"
                    }
                  }
                }
              ]
            }
          ],
          "tls_connection_policies": [
            {
              "match": {
                "sni": ["farmconnect.africa", "*.farmconnect.africa"]
              },
              "protocol_min": "tls1.2",
              "protocol_max": "tls1.3",
              "cipher_suites": [
                "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
                "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
                "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
                "TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256",
                "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
                "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
              ]
            }
          ],
          "logs": {
            "logger_names": {
              "farmconnect.africa": "access",
              "api.farmconnect.africa": "api-access"
            }
          }
        },
        "srv1": {
          "listen": [":80"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": ["https://{http.request.host}{http.request.uri}"]
                  },
                  "status_code": 301
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": ["farmconnect.africa", "*.farmconnect.africa"],
            "issuers": [
              {
                "module": "acme",
                "email": "platform@farmconnect.africa",
                "ca": "https://acme-v02.api.letsencrypt.org/directory"
              },
              {
                "module": "acme",
                "email": "platform@farmconnect.africa",
                "ca": "https://acme.zerossl.com/v2/DV90"
              }
            ]
          }
        ]
      }
    },
    "metrics": {}
  }
}
